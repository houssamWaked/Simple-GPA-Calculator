{
  "expo": {
    "name": "Grade Point",
    "slug": "grade-point",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon2.png",
    "scheme": "gradepoint",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0c1d14",
        "foregroundImage": "./assets/images/icon2.png",
        "backgroundImage": "./assets/images/icon2.png",
        "monochromeImage": "./assets/images/icon2.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.houssamwaked.gradepoint",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon2.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#0c1d14",
          "dark": {
            "backgroundColor": "#0c1d14"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9254a05d-323d-4183-ae70-ec5236ff4cc4"
      }
    }
  }
}
